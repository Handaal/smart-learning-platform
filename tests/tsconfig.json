{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "CommonJS",
    "lib":             ["ES2022"],
    "moduleResolution":"node",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "baseUrl":         "..",
    "paths": {
      "@/*": ["backend/src/*"]
    },
    "typeRoots": [
      "../backend/node_modules/@types",
      "../backend/node_modules"
    ],
    "types": ["jest", "node"]
  },
  "include": ["./**/*.ts", "../backend/src/**/*.ts"]
}
