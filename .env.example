# ─────────────────────────────────────────────────────────────
# Deployment env for docker compose. Copy to .env on the VPS:
#   cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────

# Postgres (must be set — compose refuses to start without it)
POSTGRES_DB=step_db
POSTGRES_USER=step_user
POSTGRES_PASSWORD=

# Required. Generate with: openssl rand -hex 48
JWT_SECRET=

# Public port nginx binds on the host. Use 8080 if a host web server owns 80.
HTTP_PORT=80

# Public origin of the app, e.g. https://step.example.com
# Only needed if the API is served from a different host than the frontend.
CORS_ORIGIN=http://localhost

# Leave empty for the standard same-origin setup (nginx proxies /api and /ws).
VITE_API_BASE_URL=

LOG_LEVEL=info

# AI services (optional — only used with: docker compose --profile ai up -d)
AI_SERVICE_API_KEY=dev-key
