# ─────────────────────────────────────────────────────────────
# STEP Platform — Environment Variables
# Copy to .env and fill in values before starting
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://step_user:step_pass@localhost:5432/step_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ── AI Services ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-key

# ── AWS S3 (optional — for artifact file uploads) ─────────────
AWS_REGION=eu-west-1
AWS_S3_BUCKET=step-platform-artifacts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional explicit path used by /api/health/ready to verify face model assets
FACE_MODEL_ASSETS_DIR=
REQUIRE_MODEL_ASSETS_CHECK=false
